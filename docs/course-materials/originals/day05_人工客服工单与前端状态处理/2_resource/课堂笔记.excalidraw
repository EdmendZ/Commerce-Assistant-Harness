      "type": "text",
      "x": -1511.812430212768,
      "y": 32524.129767803708,
      "width": 1692,
      "height": 135,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "buH",
      "roundness": null,
      "seed": 549409706,
      "version": 709,
      "versionNonce": 258920566,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789550428862,
      "created": 1789549310464,
      "link": null,
      "locked": false,
      "text": "总结：人工客服的第一阶段和最后一个阶段会产生两种事件类型，中间的三个阶段只会产生一种事件类型。\n3阶段.用户发送消息-----Message_Created：事件类型\n4阶段：人工客服发送消息----Message_Created事件类型",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "总结：人工客服的第一阶段和最后一个阶段会产生两种事件类型，中间的三个阶段只会产生一种事件类型。\n3阶段.用户发送消息-----Message_Created：事件类型\n4阶段：人工客服发送消息----Message_Created事件类型",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
