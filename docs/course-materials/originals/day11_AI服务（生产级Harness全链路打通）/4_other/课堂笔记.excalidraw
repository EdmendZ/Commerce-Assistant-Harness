    {
      "id": "3_F9saI248BodfoVA7Web",
      "type": "text",
      "x": -723.2380464682278,
      "y": 47552.6488120315,
      "width": 2667.6357421875,
      "height": 90,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c08W",
      "roundness": null,
      "seed": 777569177,
      "version": 1220,
      "versionNonce": 1773897815,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790226315448,
      "created": 1790218365019,
      "link": null,
      "locked": false,
      "text": "SkillScopeMiddleware：中间件的职责：根据skill_code,选择该skill下的工具对象，进一步为，后面真正执行工具调用时服务。\n介入时机：【每一次模型调用前】（不是一次模型调用），来执行到awrap_model_call。方法进来多少次，完全取决于Agent解决当前任务的时候，需要多少次模型调用",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SkillScopeMiddleware：中间件的职责：根据skill_code,选择该skill下的工具对象，进一步为，后面真正执行工具调用时服务。\n介入时机：【每一次模型调用前】（不是一次模型调用），来执行到awrap_model_call。方法进来多少次，完全取决于Agent解决当前任务的时候，需要多少次模型调用",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "xBcpYok9tg2CXnCAju_vs",
      "type": "text",
      "x": -457.94311067545436,
      "y": 47764.232578907475,
      "width": 1285.307861328125,
      "height": 180,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
